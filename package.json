    "dompurify": "^3.4.17",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "lyrics-finder": "^21.7.0",
    "mongoose": "^8.11.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.5.0",
