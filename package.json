{
  "name": "sangeetX",
  "version": "1.0.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/app-update.test.js tests/backend.test.js tests/browser.test.js tests/email.test.js tests/mobile-utils.test.js tests/security.test.js tests/production-setup.test.js tests/push.test.js tests/startup.test.js tests/youtube.test.js",
    "postinstall": "node scripts/prepare-render-youtube.js",
    "dev": "nodemon main.js",
    "new": "nodemon main.js",
    "start": "node main.js",
    "email:start": "node testEmail.js",
    "setup:youtube": "node scripts/install-youtube-extractor.js",
    "mobile": "cd mobile && npx expo start",
    "mobile:tunnel": "cd mobile && npx expo start --tunnel -c",
    "mobile:clear": "cd mobile && npx expo start -c",
    "mobile:android": "cd mobile && npx expo start --android",
    "mobile:ios": "cd mobile && npx expo start --ios",
    "mobile:web": "cd mobile && npx expo start --web",
    "mobile:apk": "npm --prefix mobile run build:preview",
    "test:backend": "node --test tests/backend.test.js",
    "test:browser": "node --test tests/browser.test.js",
    "test:security": "node --test tests/security.test.js",
    "lint": "eslint app.js main.js sockets.js routes models middlewares utils services scripts public/JS tests",
    "test:mobile": "npm --prefix mobile run build:web && node --test tests/mobile-browser.test.js",
    "test:all": "npm --prefix mobile run build:web && node --test --test-concurrency=1 tests/*.test.js"
  },
