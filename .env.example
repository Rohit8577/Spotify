DATABASE_URL=mongodb://127.0.0.1:27017/sangeetx
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
NODE_ENV=development

# Resend: sending key authorized for the verified sangeetx.online domain
RESEND_API_KEY=
RESEND_FROM="SangeetX <no-reply@sangeetx.online>"

# Music provider and optional AI services
SAVAN_URL=
googleApi=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
YOUTUBE_API_KEY=

# Optional browser Google OAuth / Firebase mobile login
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALLBACK_URL=http://localhost:5000/auth/google/callback
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set only when deploying behind a known reverse proxy.
# TRUST_PROXY=1
# Exact extra browser origins (scheme + host + port), separated by commas.
# Same-origin web and native mobile clients work without this setting.
# For a separate Expo web frontend, add its actual origin; no wildcards or trailing slash.
TRUSTED_ORIGINS=
