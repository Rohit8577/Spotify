DATABASE_URL=mongodb://127.0.0.1:27017/sangeetx
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
NODE_ENV=development

# Resend: sending key authorized for the verified sangeetx.online domain
RESEND_API_KEY=
RESEND_FROM="SangeetX <no-reply@sangeetx.online>"

# Music provider and optional AI services
SAVAN_URL=
googleApi=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
YOUTUBE_API_KEY=
# Audio-only playback: run npm run setup:youtube on the backend.
# Optionally use an existing yt-dlp executable instead of .tools/yt-dlp.
YT_DLP_PATH=
YOUTUBE_AUDIO_ENABLED=true

# Published APK metadata. Update these only after building and verifying the APK.
LATEST_APP_VERSION=1.1.0
LATEST_APP_VERSION_CODE=5
LATEST_APP_APK_URL=https://expo.dev/artifacts/eas/JuirtOASe3xwS4GwGbI1Bp4RbzLWxpbkQ_DKhnvdoG4.apk
MIN_SUPPORTED_APP_VERSION=1.0.0
LATEST_APP_FORCE_UPDATE=false
# Separate server-side key for changing release metadata; never use JWT_SECRET here.
ADMIN_SECRET=

# Optional browser Google OAuth (mobile uses email/JWT login)
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALLBACK_URL=http://localhost:5000/auth/google/callback

# Optional Expo Push Service enhanced security token (backend only).
EXPO_ACCESS_TOKEN=

# Set only when deploying behind a known reverse proxy.
# TRUST_PROXY=1
# Exact extra browser origins (scheme + host + port), separated by commas.
# Same-origin web and native mobile clients work without this setting.
# For a separate Expo web frontend, add its actual origin; no wildcards or trailing slash.
TRUSTED_ORIGINS=
