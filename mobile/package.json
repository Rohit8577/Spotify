{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "axios": "^1.21.1",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-image-colors": "^2.6.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "socket.io-client": "^4.8.4"
  },
  "scripts": {
    "postinstall": "node scripts/configure-background-audio.cjs",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel -c",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "icons:generate": "node scripts/generate-icons.cjs",
    "test:icons": "node --test scripts/__tests__/icons.test.cjs",
    "build:web": "expo export --platform web",
    "build:all": "expo export --platform all",
    "build:preview": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:production": "npx --yes eas-cli@latest build --platform android --profile production",
    "update:preview": "npx --yes eas-cli@latest update --channel preview --environment preview --platform android",
    "update:production": "npx --yes eas-cli@latest update --channel production --environment production --platform android"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.8",
    "@expo/ngrok": {
      "uuid": "^11.1.1"
    }
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
